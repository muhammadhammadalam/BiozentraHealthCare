# Copy this file to .env and fill in real values - NEVER commit .env to git

# Database - change ALL of these before deploying
DATABASE_URL=postgresql://biozentra:CHANGE_ME_DB_PASS@db:5432/biozentra_db
POSTGRES_USER=biozentra
POSTGRES_PASSWORD=CHANGE_ME_DB_PASS
POSTGRES_DB=biozentra_db

# Security - generate a strong random string: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# Token expiry (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60
